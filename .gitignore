# Generated Nix leaves and private runtime state beside the XDG checkout
/nix-packages
/nix-packages.el
/certs/
/url/

# Data, state and caches live under $XDG_DATA_HOME/emacs,
# $XDG_STATE_HOME/emacs and $XDG_CACHE_HOME/emacs (lisp/user-paths.el).
# The rules in this file for such paths are a safety net: an Emacs started
# with -Q still writes to its built-in defaults here, and `git add -A' must
# never pick that up.  `make check-litter' shows what these rules hide.
/auto-save-list/
/multisession/
/projects.eld
/tree-sitter/
/%backup%~
/.org-id-locations
/bookmarks
/bookmarks.eld
/elpa/
/history
/ido.last
/ielm-history.eld
/network-security.data
/network-security.eld
/org-clock-save.el
/package-quickstart.el
/places
/places.eld
/recentf
/recentf.eld
/server/
/tramp

# What agent tools and the Finder leave here.  These rules keep it out of
# `git add -A' on every machine, and they are why `make check-litter'
# passes over it: a global ignore file differs from one machine to the
# next, and the report must not.
/.claude/settings.local.json
/.claude/worktrees/
/.superpowers/
.DS_Store

# More defaults, of Emacs itself and of the packages this configuration
# loads: state, caches, and what Emacs records as it is used (bookmarks,
# scores, logs, a diary, notes).  None of it belongs in a commit, and
# `make check-litter' lists whatever turns up.  Code (user-lisp/,
# auctex/style/, themes) has no rule on purpose: it stays visible, and the
# report lists it while it is untracked.
/.emacs.desktop
/.emacs.desktop.lock
/.lsp-eslint-choices
/.mc-lists.el
/.persistent-scratch
/aria2-controller.eieio
/aria2c.session
/bdfcache.el
/bm-repository
/completions
/diary
/ecompleterc
/ede-projects.el
/eww-bookmarks
/filesets-cache.el
/games/
/idlwave/
/image-dired/
/index.sqlite
/intelephense/
/kkcrc
/lena-snapshots/
/lsp-cache/
/newsticker/

/url/

# Data, state and caches live under $XDG_DATA_HOME/emacs,
# $XDG_STATE_HOME/emacs and $XDG_CACHE_HOME/emacs (lisp/user-paths.el).
# The rules in this file for such paths are a safety net: an Emacs started
# with -Q still writes to its built-in defaults here, and `git add -A' must
# never pick that up.  `make check-litter' shows what these rules hide.
/auto-save-list/
/multisession/
/projects.eld
/tree-sitter/
/%backup%~
/.org-id-locations
/bookmarks
/bookmarks.eld
/elpa/
/history
/ido.last
/ielm-history.eld
/network-security.data
/network-security.eld
/org-clock-save.el
/package-quickstart.el
/places
/places.eld
/recentf
/recentf.eld
/server/
/tramp

# What agent tools and the Finder leave here.  `make check-litter' passes
# over them only because this file ignores them: a global ignore file
# differs from one machine to the next, and the report must not.
/.claude/settings.local.json
/.claude/worktrees/
/.superpowers/
.DS_Store
